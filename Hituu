<script>

/* =========================
   TYPING ANIMATION
========================= */

const words = [
  "Creator",
  "Vlogger",
  "Gamer",
  "Storyteller"
];

let wordIndex = 0;
let charIndex = 0;
let deleting = false;

const typingText =
  document.getElementById("typing-text");


function typeEffect() {

  const currentWord =
    words[wordIndex];

  if (!deleting) {

    typingText.textContent =
      currentWord.substring(
        0,
        charIndex + 1
      );

    charIndex++;

    if (charIndex === currentWord.length) {

      deleting = true;

      setTimeout(typeEffect, 1300);

      return;
    }

  } else {

    typingText.textContent =
      currentWord.substring(
        0,
        charIndex - 1
      );

    charIndex--;

    if (charIndex === 0) {

      deleting = false;

      wordIndex =
        (wordIndex + 1) % words.length;

    }

  }

  setTimeout(
    typeEffect,
    deleting ? 55 : 100
  );

}

typeEffect();

</script>
